# Copy to .env and fill in. .env is gitignored; these values never leave your machine.

# Supabase project URL (Settings -> API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-side key that bypasses RLS: the secret key (sb_secret_...) or the legacy service_role key.
# Never the publishable/anon key, and never put this in the Expo app.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed if "Enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=

# Optional: require a password in the dashboard before it reads devices or sends anything.
DASHBOARD_PASSWORD=

# Optional, defaults shown. APP_ID matches shared/appConfig.ts in the app (../concept1 for Years of Us).
APP_ID=2
PROJECT_NAME=Years of Us
DASHBOARD_PORT=5178

# Optional: more than one project. List ids here and the dashboard shows a project picker.
# Each id reads <ID>_NAME, <ID>_APP_ID, <ID>_SUPABASE_URL, <ID>_SUPABASE_SERVICE_ROLE_KEY and
# <ID>_EXPO_ACCESS_TOKEN (id upper-cased, dashes as underscores). Anything left out falls back to the
# shared value above, so apps in the same Supabase project only need a name and an app id.
# PROJECTS=years-of-us,other-app
# YEARS_OF_US_NAME=Years of Us
# YEARS_OF_US_APP_ID=2
# OTHER_APP_NAME=Other App
# OTHER_APP_APP_ID=3
# OTHER_APP_SUPABASE_URL=https://OTHER_PROJECT_REF.supabase.co
# OTHER_APP_SUPABASE_SERVICE_ROLE_KEY=
~